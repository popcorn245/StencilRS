      "docs": {
        "tags": [
          {
            "name": "name",
            "text": "pop-icon"
          },
          {
            "name": "description",
            "text": "A perfectly-centered icon atom that wraps `ion-icon`. Unlike a\nbare `ion-icon`, it renders as a centered inline-flex block with\n`line-height: 0`, so the glyph never picks up inline/baseline offset.\n\nSizing: the icon inherits `1em` from the host font-size, so callers can size\nit with CSS `font-size` or the `--size` custom property. The optional `size`\nprop sets `font-size` on the host directly."
          }
        ],
