{
  "name": "@popcorn245/stencilrs",
  "version": "0.0.0-development",
  "license": "MIT",
  "description": "Stencil v5 component transforms in Rust (oxc), for Rolldown and tsgo",
  "keywords": [
    "stencil",
    "web-components",
    "compiler",
    "oxc",
    "rust",
    "vite",
    "napi"
  ],
  "homepage": "https://github.com/popcorn245/StencilRS#readme",
  "bugs": "https://github.com/popcorn245/StencilRS/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popcorn245/StencilRS.git"
  },
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:native": "napi build --platform --release --package stencilrs_napi --manifest-path crates/stencilrs_napi/Cargo.toml --output-dir . --no-js --dts target/napi.d.ts",
    "test": "cargo test && node --test \"test/**/*.test.js\"",
    "parity:snapshot": "npm --prefix parity run snapshot",
    "parity": "npm --prefix parity run compare",
    "parity:sourcemaps": "npm --prefix parity run sourcemaps",
    "parity:scope-css": "npm --prefix parity run scope-css",
    "parity:fold-build-flags": "npm --prefix parity run fold-build-flags",
    "bench": "npm --prefix parity run bench",
    "test:starter": "npm --prefix examples/starter test"
  },
  "exports": {
    ".": "./index.js",
    "./express": {
      "types": "./express.d.ts",
      "default": "./express.js"
    },
    "./islands": "./islands-client.js",
    "./vite": "./vite.js",
    "./ssr": {
      "types": "./ssr.d.ts",
      "default": "./ssr.js"
    },
    "./signals": {
      "types": "./signals.d.ts",
      "default": "./signals.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "default": "./runtime.js"
    },
    "./runtime/server": {
      "types": "./runtime-server.d.ts",
      "default": "./runtime-server.js"
    }
  },
  "files": [
    "index.js",
    "binding.js",
    "express.js",
    "express.d.ts",
    "express-hydrate.js",
    "express-islands.js",
    "islands-client.js",
    "islands-manifest.js",
    "express-stream.js",
    "express-worker.js",
    "vite.js",
    "vite-css.js",
    "vite-types.js",
    "vite-docs.js",
    "vite-project.js",
    "vite-fold.js",
    "vite-fallback.js",
    "vite-hint.js",
    "vite-typecheck.js",
    "ssr.js",
    "ssr-collection.js",
    "ssr.d.ts",
    "ssr-serializer.js",
    "ssr-patches.js",
    "client-patches.js",
    "render-cache.js",
    "ssr-shadow-styles.js",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "signals.js",
    "signals.d.ts",
    "runtime.js",
    "runtime-hot.js",
    "runtime-features.js",
    "runtime.d.ts",
    "runtime-server.js",
    "runtime-server.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "stencilrs",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "dependencies": {
    "signal-polyfill": "^0.2.3"
  },
  "peerDependencies": {
    "@stencil/core": "5.0.0-beta.25",
    "@stencil/unplugin": "5.0.0-beta.25",
    "vite": ">=8",
    "happy-dom": ">=20"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8",
    "@semantic-release/exec": "^7.1.0",
    "@stencil/core": "5.0.0-beta.25",
    "@stencil/unplugin": "5.0.0-beta.25",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "happy-dom": "^21.0.1",
    "sass": "^1.99.0",
    "semantic-release": "^25.0.9",
    "vite": "8.4.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "chore",
              "scope": "deps",
              "release": "patch"
            },
            {
              "type": "build",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "perf",
                "section": "Performance Improvements"
              },
              {
                "type": "revert",
                "section": "Reverts"
              },
              {
                "type": "chore",
                "scope": "deps",
                "section": "Dependencies"
              },
              {
                "type": "build",
                "scope": "deps",
                "section": "Dependencies"
              },
              {
                "type": "docs",
                "hidden": true
              },
              {
                "type": "style",
                "hidden": true
              },
              {
                "type": "chore",
                "hidden": true
              },
              {
                "type": "refactor",
                "hidden": true
              },
              {
                "type": "test",
                "hidden": true
              },
              {
                "type": "build",
                "hidden": true
              },
              {
                "type": "ci",
                "hidden": true
              }
            ]
          }
        }
      ],
      [
        "@semantic-release/exec",
        {
          "verifyReleaseCmd": "echo ${nextRelease.version} > .release-version",
          "prepareCmd": "node scripts/release.mjs ${nextRelease.version}",
          "publishCmd": "bash scripts/publish.sh"
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "releasedLabels": false
        }
      ]
    ]
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    }
  }
}
